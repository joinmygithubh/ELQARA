{
  "name": "elqara-server",
  "version": "1.0.0",
  "description": "Backend API for ELQARA Premium Lamp & Home Decor E-Commerce",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seed.js",
    "build:worker": "wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
